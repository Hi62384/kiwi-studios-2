    "source_sha256": "e7c9864f254e080217e2ad09cd72401aaa8b18d1e73795d49eb1e09e087bcf32",
    "source": "// Slope Based Texture Blending\n// Grass-like cover on upward faces with exposed rock on steep slopes.\n// Target: MeshInstance3D surface material or material override; UVs required unless stated otherwise.\nshader_type spatial;\nuniform float threshold : hint_range(0,1)=0.55;\nuniform float softness : hint_range(0.01,0.5)=0.1;\nvarying vec3 world_pos;\nvarying vec3 world_normal;\n// Integer lattice hashing avoids discontinuities caused by GPU sine/FMA precision.\nfloat hash21(vec2 p) {\n    ivec2 lattice=ivec2(floor(p));\n    uint value=uint(lattice.x)*uint(374761393)+uint(lattice.y)*uint(668265263);\n    value=(value ^ (value >> uint(13)))*uint(1274126177);\n    value=value ^ (value >> uint(16));\n    return float(value & uint(16777215))/16777215.0;\n}\nfloat noise2(vec2 p) {\n    vec2 i=floor(p), f=fract(p);\n    f=f*f*(3.0-2.0*f);\n    return mix(mix(hash21(i),hash21(i+vec2(1,0)),f.x),mix(hash21(i+vec2(0,1)),hash21(i+vec2(1,1)),f.x),f.y);\n}\nfloat fbm(vec2 p) {\n    float s=0.0, a=0.5;\n    for(int i=0;i<5;i++) {\n        s+=a*noise2(p);\n        p=mat2(vec2(1.6,1.2),vec2(-1.2,1.6))*p;\n        a*=0.5;\n    }\n    return s;\n}\nvoid vertex() {\n    world_pos=(MODEL_MATRIX*vec4(VERTEX,1)).xyz;\n    world_normal=normalize(MODEL_NORMAL_MATRIX*NORMAL);\n}\nvoid fragment() {\n    float slope=abs(normalize(world_normal).y);\n    float cover=smoothstep(threshold-softness,threshold+softness,slope);\n    float n=fbm(world_pos.xz*5.0);\n    ALBEDO=mix(vec3(0.25,0.23,0.21),vec3(0.17,0.36,0.07),cover)*(0.7+n*0.5);\n    ROUGHNESS=0.9;\n}\n"
  },
