    "source": "// Procedural Noise Fog\n// Volumetric fractal density with three-axis variation creates broken cloud pockets.\n// Target: FogVolume.material with volumetric fog enabled (Forward+ renderer). Not a mesh material.\nshader_type fog;\nuniform float density : hint_range(0,5)=1;\nuniform vec4 fog_color : source_color=vec4(0.6,0.72,0.85,1);\nuniform float scale : hint_range(0.1,10)=1.5;\n// Integer lattice hashing avoids discontinuities caused by GPU sine/FMA precision.\nfloat hash21(vec2 p) {\n    ivec2 lattice=ivec2(floor(p));\n    uint value=uint(lattice.x)*uint(374761393)+uint(lattice.y)*uint(668265263);\n    value=(value ^ (value >> uint(13)))*uint(1274126177);\n    value=value ^ (value >> uint(16));\n    return float(value & uint(16777215))/16777215.0;\n}\nfloat noise2(vec2 p) {\n    vec2 i=floor(p), f=fract(p);\n    f=f*f*(3.0-2.0*f);\n    return mix(mix(hash21(i),hash21(i+vec2(1,0)),f.x),mix(hash21(i+vec2(0,1)),hash21(i+vec2(1,1)),f.x),f.y);\n}\nfloat fbm(vec2 p) {\n    float s=0.0, a=0.5;\n    for(int i=0;i<5;i++) {\n        s+=a*noise2(p);\n        p=mat2(vec2(1.6,1.2),vec2(-1.2,1.6))*p;\n        a*=0.5;\n    }\n    return s;\n}\nvoid fog() {\n    vec3 p=WORLD_POSITION*scale;\n    float n=(fbm(p.xz+p.y*0.2)+fbm(p.xy+21.7))*0.5;\n    DENSITY=density*smoothstep(0.3,0.65,n);\n    ALBEDO=fog_color.rgb;\n}\n"
