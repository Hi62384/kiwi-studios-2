extends RefCounted
const Source=preload("res://Workspaces/EnvironmentWorkspace/world/WorldSource.cs")
const Roads=preload("res://Workspaces/EnvironmentWorkspace/world/road_network.gd")
static func _native() -> Object: return Engine.get_singleton("KiwiNativeServices").call("service","world_session")
static func source(item: KiwiModelComponent) -> Resource: return _native().call("source",item)
static func add(session: KiwiEnvironmentSession,position: Vector3=Vector3.ZERO,include_terrain: bool=false,adapt_starter_terrain: bool=false) -> KiwiModelComponent: return _native().call("add",session,position,include_terrain,adapt_starter_terrain)
static func _starter_terrain(session: KiwiEnvironmentSession,item: KiwiModelComponent,terrain: KiwiEnvironmentTerrain) -> bool: return _native().call("starter_terrain",session,item,terrain)
static func development_snapshot(session: KiwiEnvironmentSession,id: String,desired: Resource) -> KiwiModelDocument: return _native().call("development_snapshot",session,id,desired)
static func update(session: KiwiEnvironmentSession,id: String,authored: Resource,label: String="Edit world",prepared: Dictionary={}) -> Dictionary: return _native().call("update",session,id,authored,label,prepared)
static func preserve_reservations(current: Resource,desired: Resource) -> void: _native().call("preserve_reservations",current,desired)
static func _locked_conflict(current: Resource,desired: Resource) -> String: return _native().call("locked_conflict",current,desired)
static func _touches(points: PackedVector3Array,bounds: Rect2) -> bool: return _native().call("touches",points,bounds)
static func add_road(authored: Resource,start: Vector3,end: Vector3) -> Resource: return _native().call("add_road",authored,start,end)
static func keep_independent(session: KiwiEnvironmentSession,id: String) -> String: return _native().call("keep_independent",session,id)
static func independence_error(session: KiwiEnvironmentSession,id: String) -> String: return _native().call("independence_error",session,id)
static func detach_building(session: KiwiEnvironmentSession,id: String) -> void: _native().call("detach_building",session,id)
