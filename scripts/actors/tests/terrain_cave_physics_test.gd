extends "res://scripts/actors/tests/destruction_authoring_workspace_test.gd"
func run() -> void:
	root.size=Vector2i(1280,800); root.gui_embed_subwindows=true; var folder:=ProjectSettings.globalize_path("user://terrain-cave-physics"); DirAccess.make_dir_recursive_absolute(folder.path_join(".proj/.trash")); var project:=Project.new("Cave physics"); ResourceSaver.save(project,folder.path_join(".proj/Project.tres")); project.take_over_path(folder.path_join(".proj/Project.tres")); StaticData.loaded_project=project
	var terrain:=KiwiEnvironmentTerrain.new(); terrain.resolution=33; terrain.dimensions=Vector2(16,16); var cave:=KiwiTerrainCave.new(); cave.radius=1.5; cave.radius_variation=0.; cave.roughness=0.; cave.paths=[PackedVector3Array([Vector3(0,1,-6),Vector3(0,-3,0)])]; cave.chambers=PackedVector4Array([Vector4(0,-3,0,2.)]); terrain.caves=[cave]; terrain.prepare_volumes(); var document:=KiwiEnvironmentDocument.new(); document.add_terrain(terrain); var path:=folder.path_join("Cave.tres"); ResourceSaver.save(document,path)
	var main: Node=load("res://scenes/Main.tscn").instantiate(); root.add_child(main); await settle(10); var tabs:=get_first_node_in_group("actor_scene_tabs") as ActorSceneTabs; editor=tabs.timeline
	var env_clip:=editor.model.create_actor(editor.registry.get_definition(&"environment_asset"),0.,{&"environment_path":path}); env_clip.start_time=0.; env_clip.duration=5.
	var clip:=editor.model.create_actor(editor.registry.get_definition(&"basic_shape"),0.,{&"position":Vector3(0,-3,0),&"box_size":Vector3(.5,.5,.5)}); clip.start_time=0.; clip.duration=5.; clip.layer=1; var actor:=editor.model.actor_for_id(clip.actor_id); actor.values[&"physics"]={"enabled":true,"bounce":0.,"friction":.8}; editor.model.changed.emit(); await seek(1.5)
	var state: Dictionary=editor.physics.display_states.get(actor.id,{}); var position: Vector3=(state.get("pose",Transform3D.IDENTITY) as Transform3D).origin
	check(not state.is_empty() and position.y<-4.4 and position.y>-5.,"Existing offline rigid-body physics lands an actor on the real underground cave floor")
	await seek(.5); await seek(1.5); var repeated: Vector3=(editor.physics.display_states[actor.id].pose as Transform3D).origin; check(repeated.distance_to(position)<.001,"Rewinding and seeking the timeline reproduces cave collision deterministically")
	editor.physics.dispose(); editor.model.history.clear_history(); main.queue_free(); await settle(); print("TERRAIN CAVE PHYSICS floor_actor_position=",position); print("TERRAIN CAVE PHYSICS: %d checks, %d failures"%[checks,failures]); quit(failures)
