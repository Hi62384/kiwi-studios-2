extends "res://scripts/actors/tests/surface_growth_test.gd"
func run() -> void:
	var terrain:=KiwiEnvironmentTerrain.new(); terrain.resolution=33; terrain.dimensions=Vector2(16,16); var cave:=KiwiTerrainCave.new(); cave.roughness=0.; cave.chambers=PackedVector4Array([Vector4(0,-3,0,2)]); terrain.caves=[cave]; terrain.biomes=KiwiTerrainBiomes.new(); terrain.biomes.definitions=[KiwiTerrainBiomes.starter(0),KiwiTerrainBiomes.cave_starter(0)]; var document:=KiwiEnvironmentDocument.new(); var item:=document.add_terrain(terrain); var path:="user://unprepared-terrain.res"; ResourceSaver.save(document,path,ResourceSaver.FLAG_COMPRESS); var data:=ActorData.new(); data.type_id=&"environment_asset"; data.values[&"environment_path"]=path; var actor:=preload("res://Workspaces/EnvironmentWorkspace/environment_actor.gd").new(); actor.bind(data); root.add_child(actor); actor.set_active(true)
	check(not actor.physics_geometry_ready() and not actor._source_jobs.is_empty(),"A scene environment prepares missing derived terrain data asynchronously even before its clip first activates")
	var deadline:=Time.get_ticks_msec()+20000
	while not actor.physics_geometry_ready() and Time.get_ticks_msec()<deadline: await process_frame
	check(actor.physics_geometry_ready() and actor.error.is_empty() and actor.source_document.terrain(item.id).volumes_valid() and actor.source_document.terrain(item.id).cave_biomes_valid(),"Background preparation commits complete native collision and cave climate before physics is allowed to capture it")
	var saved:=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE) as KiwiEnvironmentDocument; check(saved.terrain(item.id).volume_chunks.is_empty() and terrain.volume_chunks.is_empty(),"Runtime preparation leaves the saved source and other owners' resources unchanged")
	var chunk:=actor.content.nodes[item.id].get_node("Chunk_0_0") as MeshInstance3D; var hit:=chunk.mesh.generate_triangle_mesh().intersect_ray(Vector3(0,-3,0),Vector3.DOWN); check(not hit.is_empty() and absf((hit.position as Vector3).y+5.)<.05,"Automatically prepared scene geometry contains the actual cave floor")
	actor.queue_free(); await process_frame; DirAccess.remove_absolute(path); print("TERRAIN ACTOR PREPARE: %d checks, %d failures"%[checks,failures]); quit(failures)
