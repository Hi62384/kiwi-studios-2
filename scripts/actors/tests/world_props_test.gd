extends "res://scripts/actors/tests/surface_growth_test.gd"
const Worlds=preload("res://Workspaces/EnvironmentWorkspace/world/world_session.gd")
const Props=preload("res://Workspaces/EnvironmentWorkspace/world/world_props.gd")
const Edit=preload("res://Workspaces/EnvironmentWorkspace/world/world_edit.gd")
func model() -> KiwiModelDocument:
	var document:=KiwiModelDocument.new(); var pole:=KiwiModelComponent.new(); pole.id="pole"; pole.title="Road marker"; pole.mesh=KiwiModelPrimitives.create("Cylinder",{"radius":.08,"height":1.,"segments":8}); pole.transform.origin.y=.5; var material:=StandardMaterial3D.new(); material.albedo_color=Color("dedbd1"); pole.surface_materials=[material]; document.components.append(pole); var cap:=KiwiModelComponent.new(); cap.id="cap"; cap.parent_id=pole.id; cap.title="Reflector"; cap.mesh=KiwiModelPrimitives.box(Vector3(.15,.15,.15)); cap.transform.origin.y=.45; var reflector:=StandardMaterial3D.new(); reflector.albedo_color=Color("f5bb48"); cap.surface_materials=[reflector]; document.components.append(cap); return document
func run() -> void:
	var session:=KiwiEnvironmentSession.new(); var world:=Worlds.add(session,Vector3(11,3,5),true); var id:=world.id; var source: Resource=Worlds.add_road(Worlds.source(world),Vector3(-80,.03,0),Vector3(80,.03,0)); source=Props.create(source,model()); var result:=await Edit.request(session,id,source); var rule_id: String=source.prop_rules[0].id; var component_id:=id+":props:"+rule_id; var rules:=session.environment().component_settings.get(component_id,{}).get("scatter") as KiwiEnvironmentScatter
	check(result.errors.is_empty() and rules!=null and session.environment().validate().is_empty(),"Object-placement rules create native scatter layers from reusable hierarchical models")
	var placed:=rules.generate(session.environment().terrain(rules.terrain_id)); var aligned:=true; var road_half:=preload("res://Workspaces/EnvironmentWorkspace/world/road_section.gd").outer_half(source.roads[0])
	for placement: Dictionary in placed.placements.values():
		var pose: Transform3D=placement.transform; var facing: Vector3=-pose.basis.z; aligned=aligned and absf(absf(pose.origin.z)-road_half-2.)<.01 and absf(facing.dot(Vector3.FORWARD if pose.origin.z>0. else Vector3.BACK)-1.)<.001
	check(placed.count==26 and aligned,"Roadside anchors maintain twelve-meter intervals, correct clearance and inward orientation across region splits")
	var identity: String=placed.placements.keys()[0]; session.action("Erase roadside instance",func(): rules.overrides[identity]={"deleted":true}); source=Worlds.source(session.document.component(id)).copy(); source.prop_rules[0].setback=4.; result=await Edit.request(session,id,source); rules=session.environment().component_settings[component_id].scatter as KiwiEnvironmentScatter; placed=rules.generate(session.environment().terrain(rules.terrain_id)); var moved:=true
	for placement: Dictionary in placed.placements.values(): moved=moved and absf(absf((placement.transform as Transform3D).origin.z)-road_half-4.)<.01
	check(result.get("development_reused",false) and placed.count==25 and not placed.placements.has(identity) and moved,"Editing placement rules preserves instance deletions and updates spacing offsets without rebuilding roads")
	session.undo(); rules=session.environment().component_settings[component_id].scatter as KiwiEnvironmentScatter; check(rules.generate(session.environment().terrain(rules.terrain_id)).count==25 and absf(absf((rules.anchor_points[0] as Transform3D).origin.z)-road_half-2.)<.001,"Undo restores generated anchors and keeps preceding instance edits"); session.redo()
	var saved:=ResourceSaver.save(session.environment(),"user://world_props.res"); var loaded:=ResourceLoader.load("user://world_props.res","",ResourceLoader.CACHE_MODE_IGNORE) as KiwiEnvironmentDocument; check(saved==OK and loaded!=null and loaded.validate().is_empty() and loaded.component_settings[component_id].scatter.overrides.has(identity),"Native save/reopen preserves placement sources, hierarchical palettes and overrides")
	var runtime:=KiwiEnvironmentRuntime.new(); root.add_child(runtime); runtime.configure(loaded); var rendered:=0
	for visual: MultiMeshInstance3D in runtime.nodes[component_id].find_children("*","MultiMeshInstance3D",true,false): rendered+=visual.multimesh.instance_count
	check(rendered==50,"The existing renderer instances every source-model child without creating one actor per roadside marker"); runtime.free()
	for mode: String in ["Region","Clusters","Grid"]:
		source=Worlds.source(session.document.component(id)).copy(); source.prop_rules[0].mode=mode; source.prop_rules[0].bounds=Rect2(-24,12,48,48); source.prop_rules[0].budget=30; result=await Edit.request(session,id,source); rules=session.environment().component_settings[component_id].scatter as KiwiEnvironmentScatter; placed=rules.generate(session.environment().terrain(rules.terrain_id)); check(result.errors.is_empty() and placed.count>0 and placed.count<=30,"Native "+mode+" placement honors its region and instance budget")
	var invalid: Resource=Worlds.source(session.document.component(id)).copy(); invalid.prop_rules[0].spacing=0.; check(not invalid.validate().is_empty(),"Invalid spacing is rejected before grid or path generation")
	var anchor:=rules.duplicate(true) as KiwiEnvironmentScatter; anchor.use_anchors=true; anchor.anchor_points=[Transform3D.IDENTITY]; anchor.anchor_ids=PackedStringArray(["one","two"]); check(not anchor.validate().is_empty(),"Invalid saved anchor metadata is rejected explicitly")
	invalid=Worlds.source(session.document.component(id)).copy(); invalid.prop_rules[0].model=null; check(not invalid.validate().is_empty(),"A null placement model is rejected before background generation")
	var empty:=KiwiEnvironmentScatter.new(); empty.palette=[{"source":null}]; check(not empty.validate().is_empty(),"A null scatter palette is rejected rather than interpreted as a file path")
	print("WORLD PROPS: %d checks, %d failures"%[checks,failures]); quit(failures)
