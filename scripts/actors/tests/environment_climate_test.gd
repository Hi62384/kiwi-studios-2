extends "res://scripts/actors/tests/surface_growth_test.gd"
const Climate=preload("res://Workspaces/EnvironmentWorkspace/environment_climate.gd")
func run() -> void:
	var climate:=Climate.new(); climate.time_mode=1; climate.start_time=6.; climate.day_length_seconds=120.; climate.latitude=45.; climate.date_day=172
	var morning: Dictionary=climate.evaluate(Vector3.ZERO,0.); var evening: Dictionary=climate.evaluate(Vector3.ZERO,60.)
	check(is_equal_approx(float(morning.time_of_day),6.) and is_equal_approx(float(evening.time_of_day),18.) and morning.sun_direction!=evening.sun_direction,"Timeline time deterministically evaluates clock and season-aware sun direction")
	climate.time_mode=0; climate.time_of_day=12.; climate.weather=0; climate.weather_intensity=0.; climate.regions=[{"id":"rain-sphere","name":"Mountain storm","enabled":true,"shape":"Sphere","center":Vector3.ZERO,"size":Vector3(20,20,20),"blend_distance":4.,"priority":1,"overrides":{"weather":"Rain","weather_intensity":.8,"temperature":-2.,"humidity":.95}}]
	var inside: Dictionary=climate.evaluate(Vector3.ZERO,5.); var outside: Dictionary=climate.evaluate(Vector3(100,0,0),5.); var edge: Dictionary=climate.evaluate(Vector3(9,0,0),5.)
	check(inside.weather=="Rain" and float(inside.rain)>.79 and float(inside.temperature)<float(outside.temperature) and outside.weather=="Clear" and float(edge.rain)<float(inside.rain),"Local weather volumes blend precipitation and climate by distance without affecting the rest of the world")
	climate.regions.clear(); var overrides: Dictionary={"climate_time":18.,"climate_weather":3,"climate_intensity":.5,"climate_clouds":.2,"climate_temperature_offset":4.,"climate_wind_add":Vector3(2,0,0)}; var directed: Dictionary=climate.evaluate(Vector3.ZERO,5.,NAN,overrides)
	check(is_equal_approx(float(directed.time_of_day),18.) and directed.weather=="Rain" and is_equal_approx(float(directed.rain),.5) and is_equal_approx(float(directed.cloud_coverage),.2) and float(directed.wind_velocity.x)>climate.wind_speed,"Animatable Scene overrides direct time, weather, intensity, clouds, temperature and shared wind")
	climate.gust_strength=.8; var gust_a: Vector3=climate.evaluate(Vector3.ZERO,1.).wind_velocity; var gust_b: Vector3=climate.evaluate(Vector3.ZERO,3.).wind_velocity; check(not gust_a.is_equal_approx(gust_b),"Wind gusts vary deterministically with timeline time")
	climate.procedural_weather=true; climate.weather_seed=8241; climate.weather_interval=100.; climate.weather_transition=20.; climate.storm_probability=.2; climate.rain_probability=.3; climate.snow_probability=.2; climate.regions.clear()
	var sequence_a: Dictionary=climate.evaluate(Vector3.ZERO,57.); var sequence_b: Dictionary=climate.evaluate(Vector3.ZERO,57.); var before_boundary: Dictionary=climate.evaluate(Vector3.ZERO,99.999); var after_boundary: Dictionary=climate.evaluate(Vector3.ZERO,100.)
	check(sequence_a==sequence_b and climate.evaluate(Vector3.ZERO,23.)==climate.evaluate(Vector3.ZERO,23.) and before_boundary.weather==after_boundary.weather,"Seeded weather scheduling is deterministic and continuous at schedule boundaries")
	var environment:=climate.make_environment(20.); var state:=climate.apply_environment(environment,20.); check(environment.background_mode==Environment.BG_SKY and environment.sky.sky_material is ProceduralSkyMaterial and state.has("wind_velocity"),"Climate builds a native procedural sky and returns shared wind, weather and sun conditions")
	var runtime: Node3D=preload("res://Workspaces/EnvironmentWorkspace/environment_runtime.gd").new(); root.add_child(runtime); var camera:=Camera3D.new(); root.add_child(camera); climate.procedural_weather=false; climate.schedule.clear(); climate.weather=2; climate.weather_intensity=.65; state=climate.evaluate(Vector3.ZERO,20.); runtime.update_weather_particles(state,camera); var rain:=runtime.get_node_or_null("Climate Rain") as GPUParticles3D; runtime.update_weather_particles(state,camera); check(rain!=null and rain.emitting and is_equal_approx(rain.amount_ratio,.65) and rain.global_position.is_equal_approx(camera.global_position),"Rain uses an intensity-scaled camera-following particle field"); climate.weather=4; state=climate.evaluate(Vector3.ZERO,20.); runtime.update_weather_particles(state,camera); var snow:=runtime.get_node_or_null("Climate Snow") as GPUParticles3D; check(snow!=null and snow.emitting and not rain.emitting,"Snow is rendered independently and clears the rain emitter"); runtime.update_weather_particles({},null); check(snow!=null and not snow.emitting,"Weather emitters stop cleanly when no active climate camera exists"); runtime.queue_free(); camera.queue_free()
	var document:=KiwiEnvironmentDocument.new(); document.climate=climate.copy_climate(); var path: String="user://environment_climate_"+ActorData.new_id()+".tres"; var saved:=ResourceSaver.save(document,path); var loaded:=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE) as KiwiEnvironmentDocument
	check(saved==OK and loaded!=null and loaded.validate().is_empty() and loaded.climate.signature()==document.climate.signature(),"Climate rules and weather regions survive environment save, load and validation")
	var session:=KiwiEnvironmentSession.new(); var original: int=session.environment().climate.signature(); session.action("Edit climate",func(): session.environment().climate.weather=2)
	session.undo(); var undone: bool=session.environment().climate.signature()==original; session.redo(); check(undone and session.environment().climate.weather==2,"Climate edits participate in native undo and redo")
	DirAccess.remove_absolute(path); environment=null; print("ENVIRONMENT CLIMATE: %d checks, %d failures"%[checks,failures]); quit(failures)
