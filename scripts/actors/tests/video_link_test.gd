extends SceneTree
const CompositingDocument=preload("res://Workspaces/CompositingWorkspace/compositing_document.gd")
const CompositingLayer=preload("res://Workspaces/CompositingWorkspace/composite_layer.gd")
const CompositingEvaluator=preload("res://Workspaces/CompositingWorkspace/compositing_evaluator.gd")
var failures := 0
func check(condition: bool, message: String) -> void:
	if not condition:
		failures += 1
		push_error(message)
func _initialize() -> void: run.call_deferred()

func run() -> void:
	var encoder := ActorVideo.executable("ffmpeg")
	check(not encoder.is_empty(), "FFmpeg is available")
	var path := "user://video_link_test_" + ActorData.new_id() + ".mp4"
	var replacement := "user://video_replace_test_" + ActorData.new_id() + ".mp4"
	var output: Array = []
	check(OS.execute(encoder, PackedStringArray(["-nostdin", "-v", "error", "-f", "lavfi", "-i", "testsrc2=size=160x90:rate=24", "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000", "-t", "3", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-c:a", "aac", ProjectSettings.globalize_path(path)]), output) == 0, "Synthetic MP4 created without capturing devices")
	check(OS.execute(encoder, PackedStringArray(["-nostdin", "-v", "error", "-f", "lavfi", "-i", "color=c=blue:size=160x90:rate=24", "-f", "lavfi", "-i", "sine=frequency=880:sample_rate=48000", "-t", "2", "-c:v", "libx264", "-c:a", "aac", ProjectSettings.globalize_path(replacement)]), output) == 0, "Replacement fixture created")
	check(FileOperations.get_type_of_file(path) == FileOperations.FileType.VIDEO, "File manager recognizes MP4")
	var registry := ActorRegistry.new()
	BasicActors.register_all(registry)
	var model := ActorTimeline.new()
	var definition := registry.get_definition(&"video")
	var clip := model.create_actor(definition, 1.0, {&"video": path})
	check(clip != null and is_equal_approx(clip.duration, 3.0), "Video duration initializes clip length")
	var actor := model.actor_for_id(clip.actor_id)
	var linked := model.actor_for_id(actor.values[&"linked_audio_actor"])
	check(linked != null and linked.parent_id == actor.id, "Video creates linked audio child")
	var audio_clip := model.clip_for_actor_id(linked.id)
	check(actor.link_timeline_children and not actor.show_timeline_children, "Video starts collapsed and linked")
	check(is_equal_approx(audio_clip.duration, clip.duration), "Audio duration matches video")
	model.move_clip(clip.id, 5.0)
	check(is_equal_approx(audio_clip.start_time, 5.0), "Linked movement includes hidden audio")
	model.history.undo()
	check(is_equal_approx(audio_clip.start_time, 1.0) and is_equal_approx(clip.start_time, 1.0), "Linked move undoes together")
	model.trim_clip(clip.id, 1.5, 2.0)
	check(is_equal_approx(audio_clip.source_offset, 0.5) and is_equal_approx(audio_clip.duration, 2.0), "Both source edges trim with video")
	model.trim_clip(clip.id, 1.5, 10.0)
	check(is_equal_approx(clip.duration, 2.0), "Video cannot extend beyond source")
	model.history.undo()
	check(is_equal_approx(audio_clip.source_offset, 0.0) and is_equal_approx(audio_clip.duration, 3.0), "Trim undo restores audio")
	model.edit_property(actor, definition, &"linked_audio_actor", "")
	check(model.actors.has(linked) and linked.parent_id.is_empty(), "Clearing link extracts rather than deletes audio")
	model.edit_property(actor, definition, &"video", replacement)
	check(model.actors.has(linked) and linked.parent_id.is_empty(), "Source replacement never deletes previously released audio")
	model.history.undo()
	model.create_video_audio(actor)
	check(model.actors.size() == 3 and actor.values[&"linked_audio_actor"] != linked.id, "Create Audio makes a fresh linked child")
	model.history.undo()
	model.history.undo()
	check(linked.parent_id == actor.id and actor.values[&"linked_audio_actor"] == linked.id, "Extraction and recreation undo independently")
	model.edit_property(actor, definition, &"video", replacement)
	check(not model.actors.has(linked) and is_equal_approx(clip.duration, 2.0), "Replacing source removes only owned audio and updates length")
	var replacement_id: String = actor.values[&"linked_audio_actor"]
	model.history.undo()
	check(model.actors.has(linked) and actor.values[&"linked_audio_actor"] == linked.id and is_equal_approx(clip.duration, 3.0), "Replacement undo restores original audio identity and length")
	model.history.redo()
	check(actor.values[&"linked_audio_actor"] == replacement_id, "Replacement redo reuses recorded identities")
	model.history.undo()
	model.set_timeline_children_linked(actor.id, false)
	model.move_clip(clip.id, 5.0)
	check(is_equal_approx(audio_clip.start_time, 1.0), "Unlinked audio remains independently editable")
	model.history.undo()
	model.history.undo()
	check(actor.link_timeline_children, "Link toggle is undoable")
	model.select(clip.id)
	model.delete_selected()
	check(model.actors.is_empty(), "Deleting video also deletes its linked audio")
	model.history.undo()
	check(model.actors.has(linked) and model.selected_id == clip.id, "Delete undo restores linked audio and original primary selection")
	var deadline := Time.get_ticks_msec() + 10000
	var frame := ActorVideo.frame(path, 1.0, true)
	while frame == null and Time.get_ticks_msec() < deadline:
		await process_frame
		frame = ActorVideo.frame(path, 1.0, true)
	check(frame != null, "FFmpeg produces seekable video preview frames")
	var composition=CompositingDocument.new(); composition.canvas_size=Vector2i(720,404); composition.duration=3.; composition.layers.clear(); var footage=composition.add_layer(CompositingLayer.Kind.VIDEO,"Footage"); footage.source_path=path; footage.end_time=3.
	var comp_evaluator=CompositingEvaluator.new(); var composite=comp_evaluator.evaluate(composition,1.0)
	check(composite!=null and composite.image.get_size()==composition.canvas_size and composite.image.get_pixel(360,202).a>0.,"Compositor decodes and composites an FFmpeg-backed video frame at timeline time")
	footage.start_time=1.; footage.source_time_offset=.5; footage.playback_speed=1.5
	check(is_equal_approx(CompositingEvaluator.source_time_for_layer(footage,3.),3.5),"Video footage maps composition time through source offset and playback speed")
	var preview: Texture2D = await FileOperations.get_file_thumbnail(path)
	check(preview != null and preview.get_width() == 720, "File manager uses a video frame thumbnail")
	var inspector := ActorInspector.new()
	root.add_child(inspector)
	model.select(clip.id)
	inspector.setup(model, registry)
	check(inspector.fields.find_children("*", "OptionButton", true, false).size() > 0, "Linked audio reference is editable in inspector")
	inspector.free()
	var runtime := definition.create_runtime(actor)
	root.add_child(runtime)
	runtime.evaluate(1.0, actor.values)
	check(runtime.get("material").albedo_texture != null, "Video frames display on viewport mesh")
	runtime.free()
	var ui_model := ActorTimeline.new()
	var ui_definition := registry.get_definition(&"video_2d")
	var ui_clip := ui_model.create_actor(ui_definition, 0.0, {&"video": path})
	var ui_actor := ui_model.actor_for_id(ui_clip.actor_id)
	var ui_audio := ui_model.actor_for_id(str(ui_actor.values[&"linked_audio_actor"]))
	check(ui_audio != null and is_equal_approx(ui_clip.duration, 3.0), "2D video also owns source-length linked audio")
	ui_model.trim_clip(ui_clip.id, 0.5, 1.5)
	check(is_equal_approx(ui_model.clip_for_actor_id(ui_audio.id).source_offset, 0.5), "2D video trims its audio child")
	ui_model.undo()
	var ui_runtime := ui_definition.create_runtime(ui_actor) as ActorUIRuntime
	root.add_child(ui_runtime)
	ui_runtime.evaluate_clip(ui_clip, 1.0)
	check(ui_runtime.visual.texture != null, "2D video displays decoded frames")
	ui_runtime.free()
	ui_model.delete_selected()
	check(ui_model.actors.is_empty(), "Deleting 2D video deletes linked audio atomically")
	ui_model.undo()
	check(ui_model.actors.size() == 2, "2D video and audio deletion undoes together")
	ui_model.history.clear_history()
	model.history.clear_history()
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(replacement))
	print("Video and child linking checks: %d failures" % failures)
	quit(failures)
