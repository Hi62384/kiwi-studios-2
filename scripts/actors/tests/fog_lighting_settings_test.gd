extends "res://scripts/actors/tests/destruction_authoring_workspace_test.gd"
const Settings=preload("res://scripts/actors/fog/fog_render_settings.gd")
func run() -> void:
	root.size=Vector2i(1400,900); root.gui_embed_subwindows=true; var folder:=ProjectSettings.globalize_path("user://fog-settings-"+ActorData.new_id()); DirAccess.make_dir_recursive_absolute(folder.path_join(".proj/.trash")); var project:=Project.new("Fog settings"); ResourceSaver.save(project,folder.path_join(".proj/Project.tres")); project.take_over_path(folder.path_join(".proj/Project.tres")); StaticData.loaded_project=project
	var main: Node=load("res://scenes/Main.tscn").instantiate(); root.add_child(main); await settle(12); var tabs:=get_first_node_in_group("actor_scene_tabs") as ActorSceneTabs; editor=tabs.timeline
	var button:=main.get_node("MainUI/ColorRect/VBoxContainer/HBoxContainer/EditorButton") as Button; button.pressed.emit(); await settle(2)
	var popup:=button.get_node_or_null("FogRenderingSettings"); check(popup!=null and popup.visible,"Editor opens a compact project-wide volumetric rendering panel")
	Settings.edit(tabs,{"size":192,"depth":96,"filter":true}); check(project.fog_rendering.get("size")==192,"Detailed sampling maps to real bounded froxel dimensions")
	editor.model.undo(); check(project.fog_rendering.is_empty(),"Undo restores the previous project sampling configuration")
	editor.model.redo(); check(project.fog_rendering.get("depth")==96,"Redo restores the authored project quality")
	var loaded:=ResourceLoader.load(project.resource_path,"",ResourceLoader.CACHE_MODE_IGNORE) as Project; check(loaded.fog_rendering==project.fog_rendering,"Project sampling settings persist on disk")
	var definition:=editor.registry.get_definition(&"light_3d"); var clip:=editor.model.create_actor(definition,0,{&"light_type":2,&"energy":8.,&"volumetric_fog_energy":0.}); var actor:=editor.model.actor_for_id(clip.actor_id); var path:=PackedStringArray(["volumetric_fog_energy"])
	editor.model.playhead_time=0.; editor.model.add_keyframe(actor,path,"Fog light energy",0.); editor.model.playhead_time=1.; editor.model.add_keyframe(actor,path,"Fog light energy",2.); editor.canvas.playhead=.5; editor._evaluate_runtimes(); await settle(3); var runtime:=editor._runtime_for_clip(clip.id)
	check(runtime.content is SpotLight3D and is_equal_approx(runtime.content.light_volumetric_fog_energy,1.) and runtime.content.light_energy==8.,"Existing timeline keyframes animate volumetric energy without altering surface energy")
	var environment_definition:=editor.registry.get_object_definition(&"environment"); var object:=environment_definition.create_object(); object.values[&"volumetric_fog_temporal_reprojection_enabled"]=false; object.values[&"volumetric_fog_temporal_reprojection_amount"]=.65; object.values[&"volumetric_fog_ambient_inject"]=.25
	var environment_clip:=editor.model.create_actor(editor.registry.get_definition(&"world_environment"),0,{&"environment":ActorObjectReference.from_object(object)}); environment_clip.start_time=0.; environment_clip.layer=2; editor.model.changed.emit(); editor._evaluate_runtimes(); await settle(2); var environment_runtime:=editor._runtime_for_clip(environment_clip.id)
	check(not environment_runtime._world_environment_resource.volumetric_fog_temporal_reprojection_enabled and is_equal_approx(environment_runtime._world_environment_resource.volumetric_fog_temporal_reprojection_amount,.65) and is_equal_approx(environment_runtime._world_environment_resource.volumetric_fog_ambient_inject,.25),"World Environment applies native temporal and ambient injection controls")
	var scene:=editor.capture_scene_data(); var scene_path:=folder.path_join("Lighting.tres"); ResourceSaver.save(scene,scene_path); var reopened:=ResourceLoader.load(scene_path,"",ResourceLoader.CACHE_MODE_IGNORE) as ActorSceneData
	check(reopened.actors.any(func(a: ActorData): return a.type_id==&"light_3d" and a.animation_track(path)!=null),"Scene serialization preserves authored volumetric-light animation")
	Settings.apply({}); editor.physics.dispose(); editor.model.history.clear_history(); main.queue_free(); await settle(); print("FOG LIGHTING SETTINGS: %d checks, %d failures"%[checks,failures]); quit(failures)
