extends "res://scripts/actors/tests/surface_growth_test.gd"
const Bake=preload("res://Workspaces/EnvironmentWorkspace/terrain/terrain_bake.gd")
func run() -> void:
	var terrain:=KiwiEnvironmentTerrain.new(); terrain.resolution=33; terrain.amplitude=2.; terrain.lod_enabled=false; terrain.prepare(); terrain.material_mask.fill(.25); var document:=KiwiEnvironmentDocument.new(); var item:=document.add_terrain(terrain); item.transform.origin=Vector3(3,2,1); var ground:=StandardMaterial3D.new(); ground.albedo_color=Color.RED; var paint:=StandardMaterial3D.new(); paint.albedo_color=Color.BLUE; document.component_settings[item.id].material=ground; document.component_settings[item.id].paint_material=paint; var runtime:=KiwiEnvironmentRuntime.new(); root.add_child(runtime); runtime.configure(document); var before:=terrain.signature(); var job:=Bake.new(); var baked: KiwiModelDocument=await job.run(runtime,item.id,root)
	check(baked!=null and baked.validate().is_empty() and terrain.signature()==before,"Terrain baking creates a valid independent editable Model without modifying its procedural source")
	if baked==null: print(job.error); runtime.queue_free(); quit(failures); return
	check(baked.components.size()==2 and baked.components[0].transform==item.transform and baked.components[1].parent_id==baked.components[0].id and baked.components[1].mesh.faces.size()==32*32*2,"The bake preserves actual native terrain topology and its transform hierarchy")
	var material:=baked.components[1].surface_materials[0] as ShaderMaterial; terrain.material_mask.fill(1.); runtime.sync(); check((material.get_shader_parameter("paint_mask") as Texture2D).get_image().get_pixel(16,16).r==.25,"Baked material masks are frozen snapshots and remain independent of subsequent terrain painting")
	var path:="user://baked-terrain.res"; ResourceSaver.save(baked,path,ResourceSaver.FLAG_COMPRESS); var reopened:=KiwiModelImport.load_document(path); check(reopened!=null and reopened.validate().is_empty() and reopened.components[1].mesh.faces.size()==2048,"Saved baked terrain opens through the existing Modeling Workspace importer")
	var current:=terrain.signature(); var cancel:=Bake.new(); cancel.cancel(); check(await cancel.run(runtime,item.id,root)==null and terrain.signature()==current,"Canceling a bake leaves its current procedural source intact")
	runtime.queue_free(); await process_frame; DirAccess.remove_absolute(path); print("TERRAIN BAKE: %d checks, %d failures"%[checks,failures]); quit(failures)
