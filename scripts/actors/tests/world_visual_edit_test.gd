extends "res://scripts/actors/tests/surface_growth_test.gd"
const Worlds=preload("res://Workspaces/EnvironmentWorkspace/world/world_session.gd")
const Edit=preload("res://Workspaces/EnvironmentWorkspace/world/world_edit.gd")
const Forests=preload("res://Workspaces/EnvironmentWorkspace/world/world_forests.gd")
const Cities=preload("res://Workspaces/EnvironmentWorkspace/world/world_settlement.gd")
func run() -> void:
	var session:=KiwiEnvironmentSession.new(); var world:=Worlds.add(session,Vector3.ZERO,true); var id:=world.id; var source: Resource=Worlds.add_road(Worlds.source(world),Vector3(-60,.03,55),Vector3(60,.03,55)); source=Forests.create(source,Vector3.ZERO); source.forests[0].budget=20; source=Cities.create(source,Vector3.ZERO); source.settlements[0].radius=18.; source.settlements[0].blocks=1; source.settlements[0].height_max=1; var result:=await Edit.request(session,id,source); var road: KiwiModelComponent; var building: KiwiModelComponent; var canopy: KiwiModelComponent; var details: KiwiModelComponent
	for item in session.document.components:
		if road==null and item.parameters.has("world_road"): road=item
		if building==null and item.parameters.has("architecture_source"): building=item
		if item.parameters.has("world_forest") and item.title=="Canopy": canopy=item
		if details==null and item.parameters.get("road_detail","")=="sidewalks": details=item
	var road_id:=road.id; var building_id:=building.id; var canopy_id:=canopy.id; var details_id:=details.id; var road_mesh:=road.mesh; var old_material:=road.surface_materials[0]; var topology:=road.mesh.vertices.duplicate(); var original_rules:=session.environment().component_settings[canopy_id].scatter as KiwiEnvironmentScatter; var replacement:=StandardMaterial3D.new(); replacement.albedo_color=Color("332244"); source=Worlds.source(session.document.component(id)).copy(); source.road_material=replacement; result=await Edit.request(session,id,source)
	check(result.errors.is_empty() and result.get("visual_only",false) and session.document.component(road_id).mesh==road_mesh and session.document.component(road_id).mesh.vertices==topology,"Changing the world road material reuses installed geometry without a road-network generation job")
	check(session.document.component(road_id).surface_materials[0]==replacement and session.document.component(details_id).surface_materials[0]!=replacement,"Material updates target road surfaces while retaining the independent sidewalk material role")
	var native_building:=session.document.component(building_id); native_building.parameters.architecture_source.roof_pitch+=2.; var edited_pitch:=float(native_building.parameters.architecture_source.roof_pitch); var rules:=session.environment().component_settings[canopy_id].scatter as KiwiEnvironmentScatter; rules.lod_bias=.7; source=Worlds.source(session.document.component(id)).copy(); source.render_distance=80.; result=await Edit.request(session,id,source); rules=session.environment().component_settings[canopy_id].scatter as KiwiEnvironmentScatter
	check(result.errors.is_empty() and result.get("visual_only",false) and rules.render_distance==80. and rules.lod_bias==.7 and rules.seed==original_rules.seed and rules.anchor_points==original_rules.anchor_points,"Distance updates reuse scatter generation settings while preserving manually edited detail controls")
	check(float(session.document.component(building_id).parameters.architecture_source.roof_pitch)==edited_pitch,"Visual changes preserve locally customized architecture sources")
	var original_distance:=rules.render_distance; source=Worlds.source(session.document.component(id)).copy(); source.render_distance=1000.; result=await Edit.request(session,id,source); rules=session.environment().component_settings[canopy_id].scatter as KiwiEnvironmentScatter; check(result.get("visual_only",false) and rules.render_distance==500.,"Increasing world distance restores the canopy default cap rather than retaining the previous shortened distance")
	rules.render_distance=123.; source=Worlds.source(session.document.component(id)).copy(); source.render_distance=200.; result=await Edit.request(session,id,source); rules=session.environment().component_settings[canopy_id].scatter as KiwiEnvironmentScatter; check(result.get("visual_only",false) and rules.render_distance==123.,"An explicit per-layer distance override survives later world-distance changes")
	var manual:=StandardMaterial3D.new(); manual.albedo_color=Color.CORAL; session.document.component(road_id).surface_materials.assign([manual]); source=Worlds.source(session.document.component(id)).copy(); source.road_material=old_material; result=await Edit.request(session,id,source); check(result.get("visual_only",false) and session.document.component(road_id).surface_materials[0]==manual,"An explicit component material override survives a source-material update")
	var outside:=session.environment().add_group("External parent"); outside.transform.origin=Vector3(12,0,4); session.reparent_components([road_id],outside.id); var pose:=session.document.world_transform(session.document.component(road_id)); source=Worlds.source(session.document.component(id)).copy(); source.render_distance+=10.; result=await Edit.request(session,id,source)
	check(result.errors.is_empty() and result.get("visual_only",false) and session.document.component(road_id).parent_id==outside.id and session.document.world_transform(session.document.component(road_id)).is_equal_approx(pose),"Partial visual snapshots preserve generated parts manually parented to external hierarchy nodes")
	session.undo(); session.redo(); check(session.document.component(road_id).surface_materials[0]==manual and session.document.component(road_id).parent_id==outside.id and session.environment().validate().is_empty(),"Visual source updates undo/redo with manual materials and parenting intact")
	var footprint: Resource=Worlds.source(session.document.component(id)).copy(); var capture:=preload("res://Workspaces/EnvironmentWorkspace/world/world_occupancy.gd").capture(session,id,footprint); var excluded: bool=not footprint.occupied.any(func(area: Dictionary): return area.owner==road_id); session.document.component(outside.id).transform.origin.x+=20.; capture=preload("res://Workspaces/EnvironmentWorkspace/world/world_occupancy.gd").capture(session,id,footprint)
	check(capture.is_empty() and excluded and footprint.occupied.any(func(area: Dictionary): return area.owner==road_id),"World-relative baselines distinguish harmless reparenting from an actual ancestor-driven move")
	source=Worlds.source(session.document.component(id)).copy(); source.render_distance=-1.; var depth:=session._undo.size(); result=await Edit.request(session,id,source); check(not result.errors.is_empty() and session._undo.size()==depth,"Invalid visual-only settings are rejected without adding history")
	print("WORLD VISUAL EDIT: %d checks, %d failures"%[checks,failures]); quit(failures)
