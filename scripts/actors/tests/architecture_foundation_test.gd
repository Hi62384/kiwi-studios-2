extends "res://scripts/actors/tests/surface_growth_test.gd"
const Buildings=preload("res://Workspaces/EnvironmentWorkspace/architecture/building_session.gd")
const Foundation=preload("res://Workspaces/EnvironmentWorkspace/architecture/building_foundation.gd")
func run() -> void:
	var session:=KiwiEnvironmentSession.new(); var terrain_item:=session.add_terrain(); var terrain:=session.environment().terrain(terrain_item.id); terrain.amplitude=3.; terrain.prepare(); var original:=terrain._base.duplicate(); var root:=Buildings.add(session,Vector3(0,2.,0)); var error:=Foundation.set_modifier(session,root.id,terrain_item.id)
	terrain=session.environment().terrain(terrain_item.id)
	check(error.is_empty() and absf(float(terrain.sample(Vector2.ZERO).height)-1.85)<.001,"Foundation modifier flattens actual terrain to the building's slab underside")
	check(is_equal_approx(terrain.height(0,0),original[0]),"Terrain outside the foundation transition keeps its original procedural height")
	check(terrain.generation.layers.size()==1 and terrain.generation.layers[0].foundation_owner==root.id and terrain.generation.layers[0].polygon.size()==4,"Foundation is stored as a building-associated editable polygon source layer")
	check(absf(terrain.height(39,32)-lerpf(original[39+32*65],1.85,.5))<.001,"Foundation edge blends smoothly into surrounding terrain")
	session.undo(); terrain=session.environment().terrain(terrain_item.id); terrain.prepare(); check(terrain._base==original,"Undo removes foundation shaping and restores exact original terrain")
	session.redo(); terrain=session.environment().terrain(terrain_item.id); var samples:=terrain.edits.duplicate(); terrain.edits[0]=.75; samples[0]=.75
	root=session.document.component(root.id); root.transform.origin.x=3.; error=Foundation.set_modifier(session,root.id,terrain_item.id)
	terrain=session.environment().terrain(terrain_item.id); check(error.is_empty() and terrain.edits==samples and terrain.generation.layers.size()==1,"Updating a moved building replaces its modifier while preserving sculpt edits")
	error=Foundation.set_modifier(session,root.id,terrain_item.id,1.,true); terrain=session.environment().terrain(terrain_item.id)
	check(error.is_empty() and terrain.generation.layers.is_empty() and is_equal_approx(terrain.height(0,0),original[0]+.75),"Removing the modifier restores previous noise and keeps authored sculpt samples")
	terrain_item=session.document.component(terrain_item.id); terrain_item.transform=Transform3D(Basis(Vector3.UP,.4),Vector3(4,1.,-2.)); root=session.document.component(root.id); root.transform=terrain_item.transform*Transform3D(Basis(Vector3.UP,.3),Vector3(0,3.,0)); error=Foundation.set_modifier(session,root.id,terrain_item.id)
	terrain=session.environment().terrain(terrain_item.id); check(error.is_empty() and absf(float(terrain.sample(Vector2.ZERO).height)-2.85)<.001,"Foundation evaluation uses terrain coordinates under independently transformed parents")
	var path:="user://building_foundation.res"; ResourceSaver.save(session.document,path); var loaded:=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE) as KiwiEnvironmentDocument
	check(loaded!=null and loaded.validate().is_empty() and loaded.terrain(terrain_item.id).generation.layers[0].foundation_owner==root.id,"Building-associated foundation source survives native save and reload")
	var previous_height: float=terrain.sample(Vector2.ZERO).height; session.action("Move building",func(): session.document.component(root.id).transform.origin+=Vector3.UP)
	terrain=session.environment().terrain(terrain_item.id)
	check(absf(float(terrain.sample(Vector2.ZERO).height)-previous_height-1.)<.001,"Committed building transforms automatically update linked foundation terrain")
	session.undo(); terrain=session.environment().terrain(terrain_item.id)
	check(absf(float(terrain.sample(Vector2.ZERO).height)-previous_height)<.001,"Building movement and its terrain change undo together")
	session.selected=[root.id]; session.delete_selected(); terrain=session.environment().terrain(terrain_item.id)
	check(terrain.generation.layers.is_empty(),"Deleting a building removes its owned terrain foundation modifier")
	session.undo(); terrain=session.environment().terrain(terrain_item.id)
	check(session.document.component(root.id)!=null and terrain.generation.layers.size()==1,"Undo restores the building and its foundation modifier together")
	print("ARCHITECTURE FOUNDATION: %d checks, %d failures"%[checks,failures]); quit(failures)
