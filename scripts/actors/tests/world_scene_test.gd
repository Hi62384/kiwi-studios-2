extends "res://scripts/actors/tests/destruction_authoring_workspace_test.gd"
const Worlds=preload("res://Workspaces/EnvironmentWorkspace/world/world_session.gd")
const Edit=preload("res://Workspaces/EnvironmentWorkspace/world/world_edit.gd")
func run() -> void:
	root.size=Vector2i(1280,800); root.gui_embed_subwindows=true; var folder:=ProjectSettings.globalize_path("user://world-scene-test"); DirAccess.make_dir_recursive_absolute(folder.path_join(".proj/.trash")); var project:=Project.new("World scene test"); ResourceSaver.save(project,folder.path_join(".proj/Project.tres")); project.take_over_path(folder.path_join(".proj/Project.tres")); StaticData.loaded_project=project
	var session:=KiwiEnvironmentSession.new(); var ground:=session.add_terrain(); var terrain:=session.environment().terrain(ground.id); terrain.resolution=33; terrain.dimensions=Vector2(32,32); terrain.amplitude=0.; terrain.generation=KiwiTerrainGenerator.new(); terrain.generation.profile=0; terrain.generation.layers=[{"id":"hill","type":"Mesa","height":8.,"width":8.,"length":8.,"center":Vector2.ZERO}]; terrain.prepare(); var owner:=Worlds.add(session); var id:=owner.id; var source: Resource=Worlds.source(owner).copy(); source.terrain_id=ground.id; source=Worlds.add_road(source,Vector3(-14,0,3),Vector3(14,0,3)); source.roads[0].mode="Tunnel"; source.roads[0].width=4.; var result:=await Edit.request(session,id,source)
	check(result.errors.is_empty(),"Scene world prepares real road and tunnel terrain geometry before save")
	var path:=folder.path_join("Road tunnel.tres"); ResourceSaver.save(session.environment(),path); var main: Node=load("res://scenes/Main.tscn").instantiate(); root.add_child(main); await settle(10); var tabs:=get_first_node_in_group("actor_scene_tabs") as ActorSceneTabs; editor=tabs.timeline
	var env_clip:=editor.model.create_actor(editor.registry.get_definition(&"environment_asset"),0.,{&"environment_path":path}); env_clip.start_time=0.; env_clip.duration=5.; var clip:=editor.model.create_actor(editor.registry.get_definition(&"basic_shape"),0.,{&"position":Vector3(0,3,3),&"box_size":Vector3.ONE*.5}); clip.start_time=0.; clip.duration=5.; clip.layer=1; var actor:=editor.model.actor_for_id(clip.actor_id); actor.values[&"physics"]={"enabled":true,"bounce":0.,"friction":.8}; editor.model.changed.emit(); await seek(1.)
	var position: Vector3=(editor.physics.display_states[actor.id].pose as Transform3D).origin
	check(position.y>.1 and position.y<.4,"Existing scene rigid-body physics lands on the road inside the excavated tunnel")
	var passage:=editor.physics.world.point_motion("world-probe",Vector3(-12,2,3),Vector3(12,2,3),.1,1,1,[actor.id]); check(passage.position.x>11.8,"Scene collision permits travel through the mountain's actual road tunnel opening")
	var roof:=editor.physics.world.point_motion("world-probe",Vector3(0,2,3),Vector3(0,7,3),.1,1,1,[actor.id]); check(roof.position.y>4. and roof.position.y<6.,"Actual underground tunnel ceiling blocks motion below the unexcavated hill surface")
	await seek(.1); await seek(1.); check((editor.physics.display_states[actor.id].pose as Transform3D).origin.distance_to(position)<.001,"World road and tunnel collision rewinds deterministically with the ordinary scene timeline")
	check(editor.model.actors.size()==2,"Static world geometry remains one environment actor rather than a timeline actor for every road section")
	var scene_path:=folder.path_join("Road Scene.tres"); ResourceSaver.save(editor.capture_scene_data(),scene_path); var loaded:=ResourceLoader.load(scene_path,"",ResourceLoader.CACHE_MODE_IGNORE) as ActorSceneData; check(loaded!=null and loaded.actors[0].values[&"environment_path"]==path,"Scene save/reload preserves the reusable editable world resource link")
	if DisplayServer.get_name()!="headless":
		var view:=SubViewport.new(); view.own_world_3d=true; view.size=Vector2i(800,540); view.render_target_update_mode=SubViewport.UPDATE_ALWAYS; root.add_child(view); var runtime:=KiwiEnvironmentRuntime.new(); view.add_child(runtime); runtime.configure(session.environment()); var environment:=WorldEnvironment.new(); environment.environment=Environment.new(); environment.environment.background_mode=Environment.BG_COLOR; environment.environment.background_color=Color("182531"); environment.environment.ambient_light_source=Environment.AMBIENT_SOURCE_COLOR; environment.environment.ambient_light_color=Color.WHITE; environment.environment.ambient_light_energy=.8; view.add_child(environment); var light:=DirectionalLight3D.new(); light.rotation_degrees=Vector3(-45,-30,0); view.add_child(light); var camera:=Camera3D.new(); view.add_child(camera); camera.position=Vector3(-25,15,23); camera.look_at(Vector3(0,2,3)); camera.current=true
		for i in 5: await RenderingServer.frame_post_draw
		view.get_texture().get_image().save_png("res://.godot/verification/world_tunnel_outside.png"); camera.position=Vector3(0,2.2,3); camera.look_at(Vector3(-15,1.,3))
		for i in 4: await RenderingServer.frame_post_draw
		view.get_texture().get_image().save_png("res://.godot/verification/world_tunnel_inside.png"); view.queue_free()
	editor.physics.dispose(); editor.model.history.clear_history(); main.queue_free(); await settle(); StaticData.loaded_project=null; print("WORLD SCENE: %d checks, %d failures"%[checks,failures]); quit(failures)
