extends "res://scripts/actors/tests/surface_growth_test.gd"
func run() -> void:
	var model:=KiwiModelDocument.new(); var item:=KiwiModelComponent.new(); item.id="inline-box"; item.title="Embedded tree stand-in"; item.mesh=KiwiModelPrimitives.box(Vector3.ONE); var shader:=Shader.new(); shader.code="shader_type spatial; uniform float strength=0.5; void vertex(){VERTEX.x += sin(TIME)*strength;}"; var material:=ShaderMaterial.new(); material.shader=shader; item.surface_materials=[material]; model.components.append(item)
	var loaded:=KiwiEnvironmentAssets.load_scatter_parts(model); check(loaded.error.is_empty() and loaded.parts.size()==1 and KiwiEnvironmentAssets.load_scatter_parts(model).key==loaded.key,"Embedded native models produce reusable cached scatter meshes without temporary files")
	var document:=KiwiEnvironmentDocument.new(); var terrain:=KiwiEnvironmentTerrain.new(); terrain.dimensions=Vector2(8,8); terrain.resolution=17; var ground:=document.add_terrain(terrain); var layer:=document.add_group("Embedded scatter"); layer.parent_id=ground.id; var rules:=KiwiEnvironmentScatter.new(); rules.terrain_id=ground.id; rules.palette=[{"source":model,"weight":1.}]; rules.region=Rect2(-3,-3,6,6); rules.density=.2; rules.budget=6; document.component_settings[layer.id]={"kind":"scatter","scatter":rules}
	var first:=KiwiEnvironmentRuntime.new(); var second:=KiwiEnvironmentRuntime.new(); root.add_child(first); root.add_child(second); first.preview_time=.5; second.preview_time=1.5; first.configure(document); second.configure(document)
	var a:=first.nodes[layer.id].get_child(0) as MultiMeshInstance3D; var b:=second.nodes[layer.id].get_child(0) as MultiMeshInstance3D; check(a!=null and b!=null and a.multimesh.instance_count==6 and document.validate().is_empty(),"Existing MultiMesh scatter renderer accepts embedded model palettes")
	var one:=a.multimesh.mesh.surface_get_material(0) as ShaderMaterial; var two:=b.multimesh.mesh.surface_get_material(0) as ShaderMaterial; var uniform:=str(one.get_meta("kiwi_time_uniform",""))
	check(one!=two and not uniform.is_empty() and absf(float(one.get_shader_parameter(uniform))-.5)<.001 and absf(float(two.get_shader_parameter(uniform))-1.5)<.001,"Separate environments keep independent scatter material clocks at initial installation")
	KiwiEnvironmentAssets.cache.clear(); material.set_shader_parameter("strength",.8); preload("res://Workspaces/ModelWorkspace/natural_render.gd").time(first,.75)
	check(absf(float(one.get_shader_parameter("strength"))-.8)<.001 and absf(float(one.get_shader_parameter(uniform))-.75)<.001 and absf(float(two.get_shader_parameter(uniform))-1.5)<.001,"Shared authored parameters survive asset-cache eviction while runtime clock changes remain isolated")
	var path:="user://embedded_scatter.res"; var saved:=ResourceSaver.save(document,path); var reopened:=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE) as KiwiEnvironmentDocument; var restored:=reopened.component_settings[layer.id].scatter as KiwiEnvironmentScatter
	check(saved==OK and restored.palette[0].source is KiwiModelDocument and KiwiEnvironmentAssets.load_scatter_parts(restored.palette[0].source).parts.size()==1,"Native save/reopen preserves self-contained editable scatter models")
	var session:=KiwiEnvironmentSession.new(); session.document=reopened; var generated:=restored.generate(reopened.terrain(ground.id)); var identity: String=generated.placements.keys()[0]; var error:=session.promote_scatter(layer.id,identity,generated.placements[identity])
	check(error.is_empty() and session.primary()!=null and restored.overrides[identity].deleted,"An embedded scatter instance promotes to ordinary editable native model components")
	session.undo(); check(session.environment().component_settings[layer.id].scatter.overrides.is_empty(),"Promoting an embedded model remains one undoable action")
	first.free(); second.free(); print("INLINE SCATTER: %d checks, %d failures"%[checks,failures]); quit(failures)
