extends "res://scripts/actors/tests/surface_growth_test.gd"
func run() -> void:
	var terrain:=KiwiEnvironmentTerrain.new(); terrain.resolution=33; terrain.dimensions=Vector2(16,16); terrain.voxel_height=.25; var cave:=KiwiTerrainCave.new(); cave.roughness=0.; cave.chambers=PackedVector4Array([Vector4(0,-3,0,2.)]); terrain.caves=[cave]; terrain.biomes=KiwiTerrainBiomes.new(); var floor_rule:=KiwiTerrainBiomes.cave_starter(0); floor_rule.surface_type="floor"; (floor_rule.materials[0] as BaseMaterial3D).albedo_color=Color.RED; var wall:=KiwiTerrainBiomes.cave_starter(1); wall.surface_type="wall"; (wall.materials[0] as BaseMaterial3D).albedo_color=Color.GREEN; var ceiling:=KiwiTerrainBiomes.cave_starter(2); ceiling.surface_type="ceiling"; ceiling.submersion=Vector2(-10000,10000); (ceiling.materials[0] as BaseMaterial3D).albedo_color=Color.BLUE
	var surface_count:=maxi(1,preload("res://Workspaces/EnvironmentWorkspace/terrain/terrain_biome_render.gd").capacity()-3)
	for index in surface_count:
		var surface:=KiwiTerrainBiomes.starter(0); surface.id="grassland" if index==0 else "surface"+str(index); surface.materials=[StandardMaterial3D.new()]; terrain.biomes.definitions.append(surface)
	terrain.biomes.definitions.append_array([floor_rule,wall,ceiling]); terrain.prepare(); terrain.prepare_biomes(); terrain.prepare_volumes()
	check(terrain.prepare_cave_biomes() and terrain.cave_biomes_valid() and not terrain.cave_biome_data.is_empty(),"A worker-compatible bounded 3D field generates cave biome suitability independently of surface biomes")
	var floor_weights:=terrain.cave_biome_at(Vector3(0,-4.8,0)); var wall_weights:=terrain.cave_biome_at(Vector3(1.8,-3,0)); var ceiling_weights:=terrain.cave_biome_at(Vector3(0,-1.2,0)); check(float(floor_weights.get("cave_dry",0.))>.9 and float(wall_weights.get("cave_damp",0.))>.9 and float(ceiling_weights.get("cave_flooded",0.))>.9,"Cave floor, wall and ceiling restrictions affect actual continuous 3D suitability queries")
	check(not terrain.biome_data.weights.has("cave_dry") and terrain.biome_at(Vector2.ZERO).has("grassland"),"Cave definitions do not contaminate the outdoor biome distribution")
	var path:="user://cave-biomes.res"; ResourceSaver.save(terrain,path,ResourceSaver.FLAG_COMPRESS); var loaded:=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE) as KiwiEnvironmentTerrain; check(loaded.cave_biomes_valid() and loaded.cave_biome_at(Vector3(0,-4.8,0))==floor_weights,"Saved cave climate fields preserve semantic keys, native material sources and normalized queries")
	if DisplayServer.get_name()!="headless":
		var document:=KiwiEnvironmentDocument.new(); var item:=document.add_terrain(terrain); var view:=SubViewport.new(); view.own_world_3d=true; view.size=Vector2i(240,180); view.render_target_update_mode=SubViewport.UPDATE_ALWAYS; root.add_child(view); var runtime:=KiwiEnvironmentRuntime.new(); view.add_child(runtime); runtime.configure(document); var material: ShaderMaterial=runtime.nodes[item.id].get_node("Chunk_0_0").get_surface_override_material(0); check(material.get_shader_parameter("has_cave_fields") and (material.get_shader_parameter("cave_weights") as Texture3D).get_depth()==terrain.cave_biome_data.size.z,"Native terrain receives the real 3D cave material textures")
		var environment:=WorldEnvironment.new(); environment.environment=Environment.new(); environment.environment.background_mode=Environment.BG_COLOR; environment.environment.background_color=Color.BLACK; environment.environment.ambient_light_source=Environment.AMBIENT_SOURCE_COLOR; environment.environment.ambient_light_color=Color.WHITE; environment.environment.ambient_light_energy=1.; view.add_child(environment); var camera:=Camera3D.new(); view.add_child(camera); camera.position=Vector3(0,-3,0); camera.look_at(Vector3(0,-5,0),Vector3.FORWARD); camera.current=true
		for i in 5: await RenderingServer.frame_post_draw
		var floor_pixel:=view.get_texture().get_image().get_pixel(120,90); camera.look_at(Vector3(0,-1,0),Vector3.FORWARD)
		for i in 4: await RenderingServer.frame_post_draw
		var ceiling_pixel:=view.get_texture().get_image().get_pixel(120,90); check(floor_pixel.r>floor_pixel.b*1.5 and ceiling_pixel.b>ceiling_pixel.r*1.5,"A native camera renders different cave floor and ceiling materials at the same X/Z position")
		var bake:=preload("res://Workspaces/EnvironmentWorkspace/terrain/terrain_bake.gd").new(); var baked: KiwiModelDocument=await bake.run(runtime,item.id,root); check(baked!=null and baked.validate().is_empty(),"Cave material volumes survive a full editable terrain bake"); view.queue_free(); await process_frame
	terrain.biomes.definitions[surface_count].surface_type="ceiling"; check(not terrain.cave_biomes_valid(),"Changing a cave rule invalidates only its derived climate stage")
	DirAccess.remove_absolute(path); print("TERRAIN CAVE BIOMES: %d checks, %d failures"%[checks,failures]); quit(failures)
