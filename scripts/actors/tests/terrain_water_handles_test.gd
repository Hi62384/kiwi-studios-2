extends "res://scripts/actors/tests/environment_generation_test.gd"
func run() -> void:
	var workspace:=Workspace.new(); root.add_child(workspace); var document:=KiwiEnvironmentDocument.new(); var terrain:=KiwiEnvironmentTerrain.new(); terrain.resolution=33; terrain.dimensions=Vector2(16,16); terrain.hydrology=KiwiTerrainHydrology.new(); terrain.hydrology.automatic_rivers=false; terrain.hydrology.automatic_lakes=false; terrain.hydrology.manual_rivers=[{"id":"handles","points":PackedVector3Array([Vector3(-4,0,-4),Vector3.ZERO,Vector3(4,0,4)]),"follow_terrain":false,"width":2.,"depth":1.}]; terrain.prepare_water(); var item:=document.add_terrain(terrain); workspace.open_source(document); workspace.session.select(item.id)
	for i in 8: await process_frame
	var canvas:=workspace.canvas; canvas.camera.position=Vector3(8,10,12); canvas.camera.look_at(Vector3.ZERO); canvas.environment_tool="Water paths"; var point:=canvas.project(Vector3.ZERO); var history:=workspace.session._undo.size(); var source:=workspace.session.environment().terrain(item.id).hydrology; var before:=source.signature()
	var down:=InputEventMouseButton.new(); down.button_index=MOUSE_BUTTON_LEFT; down.pressed=true; down.position=point; canvas._gui_input(down); var motion:=InputEventMouseMotion.new(); motion.position=point+Vector2(40,15); canvas._gui_input(motion)
	check(not canvas.water_tool._drag.is_empty() and source.signature()==before,"River handle dragging previews privately while authored paths stay unchanged")
	var up:=down.duplicate(); up.pressed=false; up.position=motion.position; canvas._gui_input(up); await drain(workspace); var edited:=workspace.session.environment().terrain(item.id).hydrology
	check(edited.signature()!=before and workspace.session._undo.size()==history+1 and workspace.session.environment().terrain(item.id).water_valid(),"Releasing a river handle regenerates complete water as exactly one undoable edit")
	workspace.session.undo(); check(workspace.session.environment().terrain(item.id).hydrology.signature()==before,"Undo restores the exact original authored river path and generated water")
	workspace.session.redo(); var previous:=workspace.session.environment().terrain(item.id).hydrology.signature(); var target:=canvas.water_tool.target(); var points:=canvas.water_tool.path_points(target,0); down.position=canvas.project(points[1]); canvas._gui_input(down); var escape:=InputEventKey.new(); escape.keycode=KEY_ESCAPE; escape.pressed=true; canvas._gui_input(escape)
	check(canvas.water_tool._drag.is_empty() and workspace.session.environment().terrain(item.id).hydrology.signature()==previous and workspace._generation_jobs.is_empty(),"Escape cancels a river drag without changing source or creating a worker job")
	canvas.water_tool.river_index=0; canvas.water_tool.point_index=1; var remove:=InputEventKey.new(); remove.keycode=KEY_DELETE; remove.pressed=true; canvas._gui_input(remove); await drain(workspace)
	check(workspace.session.environment().terrain(item.id).hydrology.manual_rivers[0].points.size()==2,"The river path tool can remove a selected point while retaining valid two-point rivers")
	var state:=canvas.capture_state(); canvas.water_tool.point_index=0; canvas.restore_state(state); check(canvas.water_tool.point_index==1 or canvas.water_tool.point_index==int(state.water_handle.point),"River handle selection is preserved with the viewport's tab state")
	workspace.session._undo.clear(); workspace.session._redo.clear(); workspace.queue_free(); await process_frame; print("TERRAIN WATER HANDLES: %d checks, %d failures"%[checks,failures]); quit(failures)
