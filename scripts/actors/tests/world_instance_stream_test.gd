extends "res://scripts/actors/tests/surface_growth_test.gd"
const Stream=preload("res://Workspaces/EnvironmentWorkspace/world/world_instance_stream.gd")
func run() -> void:
	var document:=KiwiEnvironmentDocument.new(); var terrain:=KiwiEnvironmentTerrain.new(); terrain.dimensions=Vector2(1024,128); terrain.resolution=33; var ground:=document.add_terrain(terrain); ground.visible=false; var layer:=document.add_group("Streamed objects"); layer.transform=Transform3D(Basis.from_scale(Vector3(1.2,1.,1.4)),Vector3(10,0,5)); var model:=KiwiModelDocument.new(); var sphere:=KiwiModelComponent.new(); sphere.id="sphere"; sphere.mesh=KiwiModelPrimitives.create("Sphere",{"segments":16,"radius":2.}); model.components.append(sphere)
	var rules:=KiwiEnvironmentScatter.new(); rules.terrain_id=ground.id; rules.palette=[{"source":model,"weight":1.}]; rules.region=Rect2(-500,-50,1000,100); rules.use_anchors=true; rules.minimum_distance=.1; rules.budget=64; rules.render_cluster_size=32.; rules.render_distance=80.; rules.stream_instances=true; rules.collisions=true; rules.lod_enabled=true
	for index in 41: rules.anchor_points.append(Transform3D(Basis.IDENTITY,Vector3(-480+index*24,0,0)))
	document.component_settings[layer.id]={"kind":"scatter","scatter":rules}; var view:=SubViewport.new(); view.own_world_3d=true; view.size=Vector2i(640,480); root.add_child(view); var camera:=Camera3D.new(); view.add_child(camera); camera.current=true; var runtime:=KiwiEnvironmentRuntime.new(); runtime.position=Vector3(50,0,-15); view.add_child(runtime); runtime.configure(document); var node: Node3D=runtime.nodes[layer.id]; var pose:=node.global_transform; camera.position=pose*Vector3(-400,10,30); camera.look_at(pose*Vector3(-400,0,0)); runtime._process(0.); var state: Dictionary=node.get_meta("scatter_stream"); var left: Array=state.active.keys(); left.sort(); var cached: Dictionary=node.get_meta("scatter_result"); var key:=rules.signature(); var count:=0
	for batch: MultiMeshInstance3D in node.find_children("*","MultiMeshInstance3D",true,false): count+=batch.multimesh.instance_count
	check(state.packets.size()>20 and count>0 and count<41 and runtime.instances==41,"Nearby regional buffers load while all 41 logical source placements remain cached")
	var collision:=node.get_node("ScatterCollision") as MeshInstance3D; var faces:=collision.mesh.get_faces().size(); check(faces==sphere.render_mesh().get_faces().size()*41 and KiwiPhysicsGeometry.meshes(runtime,{}).has(collision),"Streaming keeps the full collision proxy discoverable by offline physics")
	camera.position=pose*Vector3(400,10,30); camera.look_at(pose*Vector3(400,0,0)); runtime._process(0.); var right: Array=state.active.keys(); right.sort(); var overlap:=false
	for identity in left: overlap=overlap or right.has(identity)
	check(not right.is_empty() and not overlap and node.get_meta("scatter_result")==cached and rules.signature()==key,"Moving the camera replaces distant GPU buffers without regenerating or changing saved placements")
	camera.position=pose*Vector3(-400,10,30); camera.look_at(pose*Vector3(-400,0,0)); runtime._process(0.); var returned: Array=state.active.keys(); returned.sort(); check(returned==left and collision.mesh.get_faces().size()==faces,"Returning to a region restores identical cached clusters under transformed environment roots")
	runtime.hide(); runtime._process(0.); check(state.active.is_empty(),"Hiding the workspace or environment releases its regional instance buffers")
	runtime.show(); runtime._process(0.); check(not state.active.is_empty(),"Showing the environment restores nearby buffers immediately")
	rules.stream_instances=false; runtime.sync(); count=0
	for batch: MultiMeshInstance3D in node.find_children("*","MultiMeshInstance3D",true,false): count+=batch.multimesh.instance_count
	check(not node.has_meta("scatter_stream") and count==41 and node.get_meta("scatter_result")==cached,"Disabling streaming restores full instance buffers from the same cached generation")
	rules.stream_instances=true; runtime.sync(); var saved:=ResourceSaver.save(document,"user://world_streaming_test.res"); var loaded:=ResourceLoader.load("user://world_streaming_test.res","",ResourceLoader.CACHE_MODE_IGNORE) as KiwiEnvironmentDocument
	check(saved==OK and loaded!=null and (loaded.component_settings[layer.id].scatter as KiwiEnvironmentScatter).stream_instances and loaded.validate().is_empty(),"Streaming configuration saves as editable native source data rather than transient camera state")
	view.queue_free(); await process_frame; print("WORLD INSTANCE STREAM: %d checks, %d failures"%[checks,failures]); quit(failures)
