extends "res://scripts/actors/tests/surface_growth_test.gd"
func run() -> void:
	var terrain:=KiwiEnvironmentTerrain.new(); terrain.resolution=33; terrain.dimensions=Vector2(32,32); terrain.biomes=KiwiTerrainBiomes.new(); var grass:=KiwiTerrainBiomes.starter(0); grass.temperature=Vector2(-100,100); grass.humidity=Vector2(0,1); var volcano:=KiwiTerrainBiomes.starter(11); volcano.frequency=1.; volcano.temperature=Vector2(-100,100); volcano.humidity=Vector2(0,1); volcano.landforms=[{"type":"Crater","height":5.,"width":8.,"length":8.}]; terrain.biomes.definitions=[grass,volcano]; terrain.prepare(); terrain.prepare_biomes(); check(terrain.biome_at(Vector2.ZERO).volcanic==0. and absf(terrain.height(16,16))<.0001,"A volcanic biome does not appear or create craters in unsuitable mixed geology")
	terrain.geology=5; terrain.prepare(); terrain.prepare_biomes(); check(terrain.biome_at(Vector2.ZERO).volcanic>.4 and terrain.height(16,16)<-2.,"Volcanic geology enables its real biome-driven crater geometry and suitability")
	var erosion:=KiwiTerrainErosion.new(); erosion.iterations=30; erosion.rainfall=.1; erosion.strength=.6; var hard:=KiwiEnvironmentTerrain.new(); hard.resolution=25; hard.dimensions=Vector2(24,24); hard.amplitude=8.; hard.geology=1; hard.erosion=[erosion]; var soft:=hard.duplicate(true) as KiwiEnvironmentTerrain; soft.geology=3; hard.prepare(); soft.prepare(); var hard_erosion:=0.; var soft_erosion:=0.
	for value in hard.derived_fields[erosion.operation_id].erosion: hard_erosion+=value
	for value in soft.derived_fields[erosion.operation_id].erosion: soft_erosion+=value
	check(soft_erosion>hard_erosion*1.1 and erosion.strength==.6,"Rock resistance changes actual hydraulic erosion while preserving authored operation settings")
	var coast:=KiwiEnvironmentTerrain.new(); coast.resolution=65; coast.dimensions=Vector2(64,64); coast.prepare()
	for z in 65:
		for x in 65: coast.edits[x+z*65]=(x-32)*(.08 if z<32 else 1.4)
	coast.hydrology=KiwiTerrainHydrology.new(); coast.hydrology.automatic_rivers=false; coast.hydrology.automatic_lakes=false; coast.hydrology.ocean_enabled=true; coast.prepare_water(); coast.biomes=KiwiTerrainBiomes.new(); coast.biomes.definitions=[KiwiTerrainBiomes.starter(0),KiwiTerrainBiomes.starter(12),KiwiTerrainBiomes.starter(13)]; coast.prepare_biomes(); var gentle:=coast.biome_at(Vector2(2,-16)); var cliff:=coast.biome_at(Vector2(2,16)); check(float(gentle.get("beach",0.))>float(gentle.get("rocky_coast",0.)) and float(cliff.get("rocky_coast",0.))>float(cliff.get("beach",0.)),"Real shoreline distance and slope distinguish gentle sandy beaches from steep rocky coasts")
	print("TERRAIN GEOLOGY hard_eroded=",hard_erosion," soft_eroded=",soft_erosion); print("TERRAIN GEOLOGY: %d checks, %d failures"%[checks,failures]); quit(failures)
