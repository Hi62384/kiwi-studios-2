extends "res://scripts/actors/tests/surface_growth_test.gd"
func run() -> void:
	var terrain:=KiwiEnvironmentTerrain.new(); terrain.resolution=33; terrain.dimensions=Vector2(16,16); terrain.biomes=KiwiTerrainBiomes.new(); terrain.biomes.definitions=[KiwiTerrainBiomes.starter(0),KiwiTerrainBiomes.starter(1)]; var red:=StandardMaterial3D.new(); red.albedo_color=Color.RED; var blue:=StandardMaterial3D.new(); blue.albedo_color=Color.BLUE; terrain.biomes.definitions[0].materials=[red]; terrain.biomes.definitions[1].materials=[blue]; var a:=PackedFloat32Array(); var b:=PackedFloat32Array(); a.resize(33*33); b.resize(33*33)
	for z in 33:
		for x in 33: var weight:=float(x)/32.; a[x+z*33]=1.-weight; b[x+z*33]=weight
	terrain.prepare(); terrain.prepare_biomes(); terrain.biome_data.weights={"grassland":a,"forest":b}
	var document:=KiwiEnvironmentDocument.new(); var item:=document.add_terrain(terrain); var view:=SubViewport.new(); view.own_world_3d=true; view.size=Vector2i(240,180); view.render_target_update_mode=SubViewport.UPDATE_ALWAYS; root.add_child(view); var runtime:=KiwiEnvironmentRuntime.new(); view.add_child(runtime); runtime.configure(document); var chunk:=runtime.nodes[item.id].get_node("Chunk_0_0") as MeshInstance3D; var material:=chunk.get_surface_override_material(0) as ShaderMaterial
	check(material!=null and material.get_shader_parameter("layer2_color")==Color.RED and material.get_shader_parameter("layer3_color")==Color.BLUE,"Biome materials reuse native source assets in the shared terrain shader")
	var weights: Image=(material.get_shader_parameter("weights0") as Texture2D).get_image(); check(absf(weights.get_pixel(16,16).b-.5)<.00001 and absf(weights.get_pixel(16,16).a-.5)<.00001,"Actual normalized biome weights drive continuous material blending")
	var environment:=WorldEnvironment.new(); environment.environment=Environment.new(); environment.environment.background_mode=Environment.BG_COLOR; environment.environment.background_color=Color.BLACK; environment.environment.ambient_light_source=Environment.AMBIENT_SOURCE_COLOR; environment.environment.ambient_light_color=Color.WHITE; environment.environment.ambient_light_energy=1.; view.add_child(environment); var camera:=Camera3D.new(); view.add_child(camera); camera.position=Vector3(0,10,0); camera.look_at(Vector3.ZERO,Vector3.FORWARD); camera.projection=Camera3D.PROJECTION_ORTHOGONAL; camera.size=16.; camera.current=true
	if DisplayServer.get_name()!="headless":
		for i in 6: await RenderingServer.frame_post_draw
		var image:=view.get_texture().get_image(); var left:=image.get_pixel(75,90); var center:=image.get_pixel(120,90); var right:=image.get_pixel(165,90); check(left.r>left.b*1.2 and right.b>right.r*1.2 and center.r>.1 and center.b>.1,"A native camera renders the biome transition smoothly across material boundaries")
	var mesh:=chunk.mesh; var paint:=StandardMaterial3D.new(); paint.albedo_color=Color.GREEN; document.component_settings[item.id].paint_material=paint; terrain.material_mask.fill(1.); runtime.sync()
	print("BIOME PAINT UPDATE mesh_same=",chunk.mesh==mesh," rebuilt=",runtime.chunks_rebuilt," green_weight=",(material.get_shader_parameter("weights0") as Texture2D).get_image().get_pixel(16,16).g)
	check(chunk.mesh==mesh and runtime.chunks_rebuilt==0,"Manual painting preserves native terrain and collision geometry")
	if DisplayServer.get_name()!="headless": check((material.get_shader_parameter("weights0") as Texture2D).get_image().get_pixel(16,16).g==1.,"The real GPU receives the manual paint override over biome surfaces")
	var path:="user://biome-materials.tres"; ResourceSaver.save(document,path); var reopened:=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE) as KiwiEnvironmentDocument; check((reopened.terrain(item.id).biomes.definitions[0].materials[0] as BaseMaterial3D).albedo_color==Color.RED and reopened.terrain(item.id).biomes_valid(),"Biome surface materials and valid climate fields survive environment save/reopen")
	check(reopened.terrain(item.id).biomes.signature()==terrain.biomes.signature(),"Embedded native materials have stable semantic biome signatures after save/reopen")
	view.queue_free(); await process_frame; DirAccess.remove_absolute(path); print("TERRAIN BIOME MATERIAL: %d checks, %d failures"%[checks,failures]); quit(failures)
