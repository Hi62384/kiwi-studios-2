+static func _relink_file_signature(path: String) -> Dictionary:
+	var file := FileAccess.open(path, FileAccess.READ)
+	if file == null: return {}
+	var result := {"bytes": file.get_length(), "modified": FileAccess.get_modified_time(path)}
+	file.close()
+	return result
